# ═══════════════════════════════════════════════════════
# Al-Qadhi Store — Telegram Bot Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values

# ─── Database (Supabase PostgreSQL) ───
SUPABASE_DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
SUPABASE_DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# ─── Store API ───
API_BASE_URL="https://alqadhi-store.com"
INTERNAL_API_SECRET=""

# ─── Bot Webhook Secret ───
# Secret for authenticating webhook calls from the store
# Falls back to INTERNAL_API_SECRET if not set
BOT_WEBHOOK_SECRET=""

# ─── Environment ───
NODE_ENV="production"
